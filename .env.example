# Alchemy HTTPS endpoint for Ethereum Sepolia
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/<API_KEY>
# Deployer private key (never commit it). It becomes DEFAULT_ADMIN_ROLE.
DEPLOYER_PRIVATE_KEY=
# Backend issuing account; defaults to the deployer
ISSUER_ADDRESS=
# Verification portal URL prefix used by tokenURI
CERTIFICATE_BASE_URI=https://<verification-portal-domain>/?hash=
# Optional, to verify the source on Etherscan
ETHERSCAN_API_KEY=
